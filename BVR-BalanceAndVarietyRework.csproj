<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>BVR-BalanceAndVarietyRework-Dev</AssemblyName>
    <Description>Nuclear Option - Balance and Variety Rework</Description>
    <Version>1.1.5</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <!-- Path to Nuclear Option Installation (MUST be defined before NuclearOptionManaged) -->
    <GamePath>X:\Installs\Games\SteamLibrary\steamapps\common\Nuclear Option</GamePath>
    <NuclearOptionManaged>$(GamePath)\NuclearOption_Data\Managed</NuclearOptionManaged>
  </PropertyGroup>

  <!-- BepInEx and Game DLL References -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp" Publicize="true">
      <HintPath>$(NuclearOptionManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(NuclearOptionManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(NuclearOptionManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(NuclearOptionManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Mirage Networking -->
    <Reference Include="Mirage">
      <HintPath>$(NuclearOptionManaged)\Mirage.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- REQUIRED: Mirage depends on this assembly for socket interfaces -->
    <Reference Include="Mirage.SocketLayer">
      <HintPath>$(NuclearOptionManaged)\Mirage.SocketLayer.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- BepInEx & Harmony -->
    <Reference Include="BepInEx">
      <HintPath>$(GamePath)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(GamePath)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Auto-Copy Compiled DLL to the BepInEx plugins folder -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFolder="$(GamePath)\BepInEx\plugins" />
  </Target>

</Project>